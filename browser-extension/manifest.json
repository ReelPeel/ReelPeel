{
  "manifest_version": 3,
  "name": "ReelPeel - Inquiry Layers Shifted",
  "version": "1.1",
  "version_name": "29_inquiry_layers_shifted",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "http://im-redstone02.hs-regensburg.de:38843/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ]
    }
  ],
  "icons": {
    "128": "icons/healthcare.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://im-redstone02.hs-regensburg.de:38843"
  }
}
